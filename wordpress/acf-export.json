[
  {
    "key": "group_reels_fields",
    "title": "Client Reel & Creative Video Settings",
    "fields": [
      {
        "key": "field_reel_client",
        "label": "Client / Brand Name",
        "name": "client",
        "type": "text",
        "required": 1
      },
      {
        "key": "field_reel_category",
        "label": "Creative Category",
        "name": "category",
        "type": "select",
        "choices": {
          "Reels": "Reels",
          "Product Shoots": "Product Shoots",
          "Brand Films": "Brand Films",
          "Ad Creatives": "Ad Creatives"
        },
        "default_value": "Reels"
      },
      {
        "key": "field_reel_aspect_ratio",
        "label": "Aspect Ratio",
        "name": "aspect_ratio",
        "type": "select",
        "choices": {
          "9:16": "9:16 (Vertical Reel)",
          "16:9": "16:9 (Cinematic Film)"
        },
        "default_value": "9:16"
      },
      {
        "key": "field_reel_duration",
        "label": "Video Duration",
        "name": "duration",
        "type": "text",
        "placeholder": "0:28"
      },
      {
        "key": "field_reel_views",
        "label": "Total Views Metric",
        "name": "views",
        "type": "text",
        "placeholder": "1.4M+"
      },
      {
        "key": "field_reel_ctr",
        "label": "Click-Through Rate (CTR)",
        "name": "ctr",
        "type": "text",
        "placeholder": "4.8%"
      },
      {
        "key": "field_reel_video_url",
        "label": "Video Source URL (MP4 / CDN)",
        "name": "video_url",
        "type": "url",
        "required": 1
      },
      {
        "key": "field_reel_thumbnail",
        "label": "Custom Poster Thumbnail",
        "name": "thumbnail",
        "type": "image",
        "return_format": "url"
      }
    ],
    "location": [
      [
        {
          "param": "post_type",
          "operator": "==",
          "value": "reels"
        }
      ]
    ]
  },
  {
    "key": "group_project_fields",
    "title": "Case Study & Project Fields",
    "fields": [
      {
        "key": "field_proj_client",
        "label": "Client Name",
        "name": "client_name",
        "type": "text",
        "required": 1
      },
      {
        "key": "field_proj_industry",
        "label": "Industry",
        "name": "industry",
        "type": "text"
      },
      {
        "key": "field_proj_category",
        "label": "Primary Category",
        "name": "category",
        "type": "select",
        "choices": {
          "Marketing": "Marketing",
          "Branding": "Branding",
          "Video Production": "Video Production",
          "E-commerce": "E-commerce",
          "Web Development": "Web Development"
        }
      },
      {
        "key": "field_proj_hero_image",
        "label": "Hero Image",
        "name": "hero_image",
        "type": "image",
        "return_format": "url"
      },
      {
        "key": "field_proj_video_url",
        "label": "Associated Video Reel URL",
        "name": "video_url",
        "type": "url"
      },
      {
        "key": "field_proj_overview",
        "label": "Project Overview",
        "name": "overview",
        "type": "textarea"
      },
      {
        "key": "field_proj_challenge",
        "label": "The Challenge",
        "name": "challenge",
        "type": "textarea"
      },
      {
        "key": "field_proj_strategy",
        "label": "The Strategy",
        "name": "strategy",
        "type": "textarea"
      },
      {
        "key": "field_proj_execution",
        "label": "Execution & Rollout",
        "name": "execution",
        "type": "textarea"
      }
    ],
    "location": [
      [
        {
          "param": "post_type",
          "operator": "==",
          "value": "projects"
        }
      ]
    ]
  }
]
