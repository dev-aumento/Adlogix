# Adlogix Headless WordPress Configuration
# URL of your WordPress installation REST API root (e.g. https://cms.adlogix.agency/wp-json)
VITE_WP_API_URL=https://cms.adlogix.agency/wp-json

# Public site domain
VITE_SITE_URL=https://adlogix.agency

# Enable live sync from WordPress REST API (defaults to graceful fallback mock when offline or during local dev)
VITE_ENABLE_WP_SYNC=false

# Google Analytics / GTM / Meta Pixel Tracking IDs
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=123456789012345
