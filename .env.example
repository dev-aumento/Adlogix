# Adlogix frontend configuration
# Copy to `.env` (or `.env.local`) and adjust. Every VITE_* value is embedded in the
# public JavaScript bundle: never put passwords, tokens, or other secrets here.

# Public, read-only WordPress REST API root (no trailing slash).
# Must be the /wp-json root, never a /wp-admin URL.
VITE_WORDPRESS_API_URL=https://adlogix.in/wp-json

# Legacy switch for the bulk collections loaded by CMSContext (services, projects,
# reels, testimonials, industries, blog, clients, team, settings).
# Keep false until each collection has been migrated and verified.
# Sections migrated individually (e.g. the homepage hero) do not depend on this flag.
VITE_ENABLE_WP_SYNC=false

# Public site domain
VITE_SITE_URL=https://adlogix.in

# Google Analytics / GTM / Meta Pixel Tracking IDs
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=123456789012345
